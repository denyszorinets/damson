{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "lanes-retry"
  },
  "spec": {
    "steps": [
      {
        "id": "per-node",
        "type": "group",
        "steps": [
          {
            "id": "install",
            "plugin": "ssh",
            "with": {
              "node": "${{ item }}",
              "command": "install ${{ item }}"
            },
            "retry": {
              "max_attempts": 3,
              "backoff": {
                "initial": "5s",
                "jitter": 0
              }
            }
          }
        ],
        "for_each": "inputs.hosts"
      }
    ]
  }
}
