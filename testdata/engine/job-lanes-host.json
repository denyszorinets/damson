{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "lanes-host"
  },
  "spec": {
    "steps": [
      {
        "id": "per-node",
        "type": "group",
        "steps": [
          {
            "id": "install",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "install ${{ item.host }}"
            }
          }
        ],
        "for_each": "inputs.hosts"
      }
    ]
  }
}
