{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "groups-timeout"
  },
  "spec": {
    "steps": [
      {
        "id": "deploy",
        "type": "group",
        "steps": [
          {
            "id": "unpack",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "unpack"
            }
          },
          {
            "id": "build",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "build"
            }
          }
        ]
      }
    ],
    "timeout": "10m"
  }
}
