{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "lanes-rethrow"
  },
  "spec": {
    "steps": [
      {
        "id": "per-node",
        "type": "group",
        "steps": [
          {
            "id": "install",
            "plugin": "ssh",
            "with": {
              "node": "${{ item }}",
              "command": "install ${{ item }}"
            }
          }
        ],
        "for_each": "inputs.hosts",
        "max_parallel": 2,
        "fail_threshold": 1,
        "catch": [
          {
            "id": "rollback",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "rollback ${{ item }} ${{ error.kind }}"
            }
          }
        ],
        "finally": [
          {
            "id": "tidy",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "tidy ${{ item }}"
            }
          }
        ],
        "rethrow": true
      },
      {
        "id": "after",
        "plugin": "ssh",
        "with": {
          "node": "n",
          "command": "after"
        }
      }
    ]
  }
}
