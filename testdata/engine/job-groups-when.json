{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "groups-when"
  },
  "spec": {
    "steps": [
      {
        "id": "g",
        "type": "group",
        "steps": [
          {
            "id": "a",
            "plugin": "ssh",
            "with": {
              "node": "n",
              "command": "a"
            }
          }
        ],
        "when": "false"
      },
      {
        "id": "after",
        "plugin": "ssh",
        "with": {
          "node": "n",
          "command": "after"
        }
      }
    ]
  }
}
