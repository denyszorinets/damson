{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "retry"
  },
  "spec": {
    "steps": [
      {
        "id": "flaky",
        "plugin": "ssh",
        "with": {
          "node": "n",
          "command": "flaky"
        },
        "retry": {
          "max_attempts": 3,
          "backoff": {
            "initial": "5s",
            "multiplier": 2,
            "max": "1m",
            "jitter": 0.2
          }
        }
      },
      {
        "id": "after",
        "plugin": "ssh",
        "with": {
          "node": "n",
          "command": "after"
        }
      }
    ]
  }
}
