{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "lanes-read"
  },
  "spec": {
    "steps": [
      {
        "id": "per-node",
        "type": "group",
        "steps": [
          {
            "id": "install",
            "plugin": "ssh",
            "with": {
              "node": "${{ item }}",
              "command": "install ${{ item }}"
            }
          }
        ],
        "for_each": "inputs.hosts"
      },
      {
        "id": "report",
        "plugin": "ssh",
        "with": {
          "node": "n",
          "command": "lane b is ${{ steps['per-node'].lanes['b'].status }} ${{ steps['per-node'].lanes['b'].steps.install.status }} item ${{ steps['per-node'].lanes['b'].item }}"
        }
      }
    ]
  }
}
