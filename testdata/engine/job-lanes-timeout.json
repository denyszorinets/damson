{
  "apiVersion": "damson.dev/v1",
  "kind": "Job",
  "metadata": {
    "project": "default",
    "name": "lanes-timeout"
  },
  "spec": {
    "steps": [
      {
        "id": "per-node",
        "type": "group",
        "steps": [
          {
            "id": "install",
            "plugin": "ssh",
            "with": {
              "node": "${{ item }}",
              "command": "install ${{ item }}"
            }
          }
        ],
        "for_each": "inputs.hosts",
        "max_parallel": 2
      }
    ],
    "timeout": "10m"
  }
}
