{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/app"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--headless",
        "--no-sandbox",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@cartographai/mcp-server-codegraph",
        "/app"
      ]
    }
  }
}
