# /etc/damson/controller.env: mode 0600, owner root. systemd reads it before it
# drops to the damson user.
DAMSON_DATABASE__DSN=postgres://damson:CHANGE-ME@db.example.com:5432/damson?sslmode=verify-full
# At least 32 bytes; the same on every controller.
DAMSON_CONTROLLER__CLUSTER_SECRET=CHANGE-ME-AT-LEAST-32-BYTES-OF-RANDOM
# Base64 of 32 random bytes (openssl rand -base64 32). Losing it loses every
# stored secret: back it up. Remove it when secrets.backend is openbao.
DAMSON_KEK=CHANGE-ME
# This controller's address for the other controllers (internal listener).
DAMSON_CONTROLLER__INTERNAL_URL=http://10.0.0.11:8081
