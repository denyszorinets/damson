{
	"name": "damson-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && touch build/.gitkeep",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test && playwright test -c playwright.oidc.config.ts",
		"lint": "prettier --check . && eslint .",
		"gen:api": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
		"format": "prettier --write .",
		"test:unit": "vitest run --dir src"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.69.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"bits-ui": "^2.20.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@sjsf/ajv8-validator": "^3.9.1",
		"@sjsf/basic-theme": "^3.9.1",
		"@sjsf/form": "^3.9.1",
		"@standard-schema/spec": "^1.1.0",
		"@types/json-schema-merge-allof": "^0.6.5",
		"@xyflow/svelte": "^1.7.1",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"json-schema-merge-allof": "^0.8.1",
		"json-schema-typed": "^8.0.2",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.7.0"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
