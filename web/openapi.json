{
  "components": {
    "schemas": {
      "Agent": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Plugin name to version.",
            "type": "object"
          },
          "capacity": {
            "format": "int64",
            "type": "integer"
          },
          "connected_at": {
            "format": "date-time",
            "type": "string"
          },
          "disconnected_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "last_seen": {
            "format": "date-time",
            "type": "string"
          },
          "pool_id": {
            "type": "string"
          },
          "protocol": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "enum": [
              "connected",
              "disconnected"
            ],
            "type": "string"
          },
          "telemetry": {
            "$ref": "#/components/schemas/Telemetry",
            "description": "Last telemetry snapshot reported by the agent."
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "pool_id",
          "status",
          "version",
          "protocol",
          "labels",
          "capabilities",
          "capacity",
          "connected_at",
          "last_seen"
        ],
        "type": "object"
      },
      "ListAgentsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Agent"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "description": "Empty on the last page.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ListPoolsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Pool"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "next_cursor": {
            "description": "Empty on the last page.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Pool": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "created_at"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Telemetry": {
        "additionalProperties": false,
        "properties": {
          "cpu_percent": {
            "description": "CPU use across all cores, 0 to 100.",
            "format": "double",
            "type": "number"
          },
          "free_slots": {
            "description": "Slots not running an attempt.",
            "format": "int64",
            "type": "integer"
          },
          "load1": {
            "description": "One-minute load average.",
            "format": "double",
            "type": "number"
          },
          "memory_bytes": {
            "description": "Used memory in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "running_attempts": {
            "description": "Attempt IDs the agent is running.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "spool_bytes": {
            "description": "Bytes of unsent output spooled on the agent.",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Damson controller HTTP API (ARCHITECTURE section 14).",
    "title": "Damson API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agents": {
      "get": {
        "operationId": "list-agents",
        "parameters": [
          {
            "description": "Opaque cursor from a previous page's next_cursor.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous page's next_cursor.",
              "type": "string"
            }
          },
          {
            "description": "Page size.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Page size.",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAgentsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List agents",
        "tags": [
          "agents"
        ]
      }
    },
    "/agents/{id}": {
      "get": {
        "operationId": "get-agent",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get an agent with its last telemetry",
        "tags": [
          "agents"
        ]
      }
    },
    "/pools": {
      "get": {
        "operationId": "list-pools",
        "parameters": [
          {
            "description": "Opaque cursor from a previous page's next_cursor.",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous page's next_cursor.",
              "type": "string"
            }
          },
          {
            "description": "Page size.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Page size.",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPoolsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List agent pools",
        "tags": [
          "pools"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
